@model List<StudentGradeManagement.Mvc.Models.Grades.GradeViewModel>

@{
    ViewData["Title"] = "Faculty Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Faculty Dashboard</h2>
            <p class="text-muted">Student academic records</p>
        </div>
        <div>
            <a asp-controller="Grades" asp-action="Index"
               class="btn btn-primary">Manage Grades</a>

            <form asp-controller="Auth" asp-action="Logout"
                  method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger">Logout</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">All Student Grades</h5>

            @if (Model.Count == 0)
            {
                <p class="text-muted">No grades available.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Student Number</th>
                                <th>Student Name</th>
                                <th>Subject</th>
                                <th>Grade</th>
                                <th>Remarks</th>
                                <th>Semester</th>
                                <th>School Year</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StudentNumber</td>
                                    <td>@item.StudentName</td>
                                    <td>@item.SubjectCode - @item.SubjectName</td>
                                    <td><strong>@item.Grade</strong></td>
                                    <td>@item.Remarks</td>
                                    <td>@item.Semester</td>
                                    <td>@item.SchoolYear</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>