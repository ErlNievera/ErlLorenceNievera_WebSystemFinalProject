
@model List<StudentGradeManagement.Mvc.Models.Grades.GradeViewModel>

@{
    ViewData["Title"] = "Faculty Dashboard";
}

<div class="container py-4 py-lg-5">
    <header class="page-heading">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="page-eyebrow">
                    <i class="bi bi-person-workspace"></i>
                    Faculty Portal
                </div>
                <h1 class="page-title">Faculty Dashboard</h1>
                <p class="page-description">
                    Review student academic records and manage grades.
                </p>
            </div>

            <a asp-controller="Grades" asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                Manage Grades
            </a>
        </div>
    </header>

    <section class="card">
        <div class="card-body">
            <div class="mb-4">
                <h2 class="card-heading">
                    <i class="bi bi-journal-text me-2"></i>
                    All Student Grades
                </h2>
                <p class="card-description">
                    Academic records currently available in the system.
                </p>
            </div>

            @if (Model == null || Model.Count == 0)
            {
                <div class="state-message text-center py-4">
                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                    <strong>No grade records found.</strong>
                    <div class="mt-1">Student grade records will appear here once added.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Student Number</th>
                                <th scope="col">Student Name</th>
                                <th scope="col">Subject</th>
                                <th scope="col">Grade</th>
                                <th scope="col">Remarks</th>
                                <th scope="col">Semester</th>
                                <th scope="col">School Year</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var failed = item.Remarks == "BEP/FAILED";

                                <tr>
                                    <td><strong>@item.StudentNumber</strong></td>
                                    <td>@item.StudentName</td>
                                    <td>
                                        <strong>@item.SubjectCode</strong>
                                        <div class="text-muted small">@item.SubjectName</div>
                                    </td>
                                    <td><strong>@item.Grade</strong></td>
                                    <td>
                                        <span class="status-badge @(failed ? "status-fail" : "status-pass")">
                                            <i class="bi @(failed ? "bi-exclamation-circle" : "bi-check-circle")"></i>
                                            @item.Remarks
                                        </span>
                                    </td>
                                    <td>@item.Semester</td>
                                    <td>@item.SchoolYear</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
