
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container py-4 py-lg-5">
    <header class="page-heading">
        <div class="page-eyebrow">
            <i class="bi bi-grid-1x2-fill"></i>
            Student Portal
        </div>
        <h1 class="page-title">My Academic Dashboard</h1>
        <p class="page-description">
            View your student information and monitor your academic performance.
        </p>
    </header>

    <section class="card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-icon flex-shrink-0">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>
                <div class="min-w-0">
                    <span class="page-eyebrow mb-1">Student profile</span>
                    <h2 class="card-heading" id="studentName">
                        Loading student information...
                    </h2>
                    <p class="card-description mb-0">
                        Student Number:
                        <strong id="studentNumber">Loading...</strong>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <h2 class="card-heading">
                        <i class="bi bi-journal-check me-2"></i>
                        My Grades
                    </h2>
                    <p class="card-description">
                        Your recorded subjects, grades, and academic remarks.
                    </p>
                </div>
                <span class="status-badge status-pass">
                    <i class="bi bi-lock-fill"></i>
                    Read only
                </span>
            </div>

            <div id="gradesMessage"
                 class="state-message"
                 role="status"
                 aria-live="polite">
                <i class="bi bi-hourglass-split me-2"></i>
                Loading your grades...
            </div>

            <div class="table-responsive d-none" id="gradesTableContainer">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Subject Code</th>
                            <th scope="col">Subject</th>
                            <th scope="col">Grade</th>
                            <th scope="col">Remarks</th>
                            <th scope="col">Semester</th>
                            <th scope="col">School Year</th>
                        </tr>
                    </thead>
                    <tbody id="gradesTableBody"></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script>
    function createRemarksBadge(remarks) {
        const badge = document.createElement("span");
        const failed = remarks === "BEP/FAILED";

        badge.className = "status-badge " +
            (failed ? "status-fail" : "status-pass");

        const icon = document.createElement("i");
        icon.className = failed
            ? "bi bi-exclamation-circle"
            : "bi bi-check-circle";

        badge.appendChild(icon);
        badge.appendChild(document.createTextNode(remarks ?? ""));

        return badge;
    }

    async function loadStudentProfile() {
        const name = document.getElementById("studentName");
        const number = document.getElementById("studentNumber");

        try {
            const response = await fetch(
                '@Url.Action("GetMyProfile", "Dashboard")',
                {
                    method: "GET",
                    headers: { "Accept": "application/json" },
                    credentials: "same-origin"
                }
            );

            if (!response.ok) {
                throw new Error("Unable to retrieve student profile.");
            }

            const profile = await response.json();

            name.textContent = profile.studentName ?? "Student";
            number.textContent = profile.studentNumber ?? "Unavailable";

        } catch (error) {
            name.textContent = "Student information unavailable.";
            number.textContent = "Unavailable";
            console.error(error);
        }
    }

    async function loadMyGrades() {
        const message = document.getElementById("gradesMessage");
        const tableContainer = document.getElementById("gradesTableContainer");
        const tableBody = document.getElementById("gradesTableBody");

        try {
            const response = await fetch(
                '@Url.Action("GetMyGrades", "Dashboard")',
                {
                    method: "GET",
                    headers: { "Accept": "application/json" },
                    credentials: "same-origin"
                }
            );

            if (response.status === 401 || response.status === 403) {
                message.textContent =
                    "You are not authorized to view these grades.";
                message.classList.add("state-error");
                return;
            }

            if (!response.ok) {
                throw new Error("Unable to retrieve grades.");
            }

            const grades = await response.json();

            if (!Array.isArray(grades) || grades.length === 0) {
                message.textContent = "No grades available yet.";
                return;
            }

            tableBody.replaceChildren();

            grades.forEach(grade => {
                const row = document.createElement("tr");

                [
                    grade.subjectCode,
                    grade.subjectName,
                    grade.grade,
                    grade.remarks,
                    grade.semester,
                    grade.schoolYear
                ].forEach((value, index) => {
                    const cell = document.createElement("td");

                    if (index === 3) {
                        cell.appendChild(createRemarksBadge(value));
                    } else if (index === 2) {
                        const strong = document.createElement("strong");
                        strong.textContent = value ?? "";
                        cell.appendChild(strong);
                    } else {
                        cell.textContent = value ?? "";
                    }

                    row.appendChild(cell);
                });

                tableBody.appendChild(row);
            });

            message.textContent = "";
            tableContainer.classList.remove("d-none");

        } catch (error) {
            message.textContent =
                "Something went wrong while loading your grades. Please try again.";
            message.classList.add("state-error");
            console.error(error);
        }
    }

    document.addEventListener("DOMContentLoaded", async () => {
        await Promise.all([
            loadStudentProfile(),
            loadMyGrades()
        ]);
    });
</script>
}
