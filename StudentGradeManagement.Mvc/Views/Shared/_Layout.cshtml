
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Grade Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar app-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2"
               asp-controller="Home" asp-action="Index">
                <span class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>
                    <span class="brand-name">Student Grade Management</span>
                    <small class="brand-caption d-block">Academic Portal</small>
                </span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="ms-auto d-flex align-items-center gap-3">
                    <div class="user-info d-none d-sm-flex align-items-center gap-2">
                        <span class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <span>
                            <strong class="user-name d-block">@User.Identity.Name</strong>
                            <small class="user-role">
                                @(User.IsInRole("Faculty") ? "Faculty" :
                                  User.IsInRole("Student") ? "Student" : "User")
                            </small>
                        </span>
                    </div>

                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-quiet btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout
                        </button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>Student Grade Management System</span>
            <span>Academic Portal</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
