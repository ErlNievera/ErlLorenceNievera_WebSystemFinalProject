
@model List<StudentGradeManagement.Mvc.Models.Grades.GradeViewModel>

@{
    ViewData["Title"] = "Manage Grades";
}

<div class="container py-4 py-lg-5">
    <header class="page-heading">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="page-eyebrow">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    Faculty Portal
                </div>
                <h1 class="page-title">Grade Management</h1>
                <p class="page-description">
                    Add, review, and update student academic records.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Grade
            </a>
        </div>
    </header>

    @if (TempData["Success"] is not null)
    {
        <div class="state-message mb-3" role="status">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="state-message state-error mb-3" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <section class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                <div>
                    <h2 class="card-heading">
                        <i class="bi bi-table me-2"></i>
                        Student Grade Records
                    </h2>
                    <p class="card-description">
                        Review the details before editing or deleting a record.
                    </p>
                </div>

                <span class="status-badge status-pass">
                    @(Model?.Count ?? 0) records
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Student Number</th>
                            <th scope="col">Student Name</th>
                            <th scope="col">Subject</th>
                            <th scope="col">Grade</th>
                            <th scope="col">Remarks</th>
                            <th scope="col">Semester</th>
                            <th scope="col">School Year</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                    <strong>No grade records found.</strong>
                                    <p class="text-muted small mb-0 mt-1">
                                        Select Add Grade to create the first record.
                                    </p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var failed = item.Remarks == "BEP/FAILED";

                                <tr>
                                    <td><strong>@item.StudentNumber</strong></td>
                                    <td>@item.StudentName</td>
                                    <td>
                                        <strong>@item.SubjectCode</strong>
                                        <div class="text-muted small">@item.SubjectName</div>
                                    </td>
                                    <td><strong>@item.Grade</strong></td>
                                    <td>
                                        <span class="status-badge @(failed ? "status-fail" : "status-pass")">
                                            <i class="bi @(failed ? "bi-exclamation-circle" : "bi-check-circle")"></i>
                                            @item.Remarks
                                        </span>
                                    </td>
                                    <td>@item.Semester</td>
                                    <td>@item.SchoolYear</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.GradeId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit this grade">
                                                <i class="bi bi-pencil"></i>
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.GradeId"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this grade record? This action cannot be undone.');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete this grade">
                                                    <i class="bi bi-trash3"></i>
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <a asp-controller="Dashboard"
       asp-action="Faculty"
       class="btn btn-quiet mt-3">
        <i class="bi bi-arrow-left"></i>
        Back to Dashboard
    </a>
</div>
