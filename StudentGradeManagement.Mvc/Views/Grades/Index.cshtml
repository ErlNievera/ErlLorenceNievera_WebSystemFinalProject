
@model List<StudentGradeManagement.Mvc.Models.Grades.GradeViewModel>

@{
    ViewData["Title"] = "Manage Grades";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Grade Management</h2>
            <p class="text-muted">Manage student academic records</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Add Grade</a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Student Number</th>
                            <th>Student Name</th>
                            <th>Subject</th>
                            <th>Grade</th>
                            <th>Remarks</th>
                            <th>Semester</th>
                            <th>School Year</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    No grade records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StudentNumber</td>
                                    <td>@item.StudentName</td>
                                    <td>@item.SubjectCode - @item.SubjectName</td>
                                    <td>@item.Grade</td>
                                    <td>@item.Remarks</td>
                                    <td>@item.Semester</td>
                                    <td>@item.SchoolYear</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.GradeId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.GradeId"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this grade record?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <a asp-controller="Dashboard" asp-action="Faculty"
       class="btn btn-link mt-3">Back to Dashboard</a>
</div>
