@model StudentGradeManagement.Mvc.Models.Grades.GradeFormViewModel

@{
    ViewData["Title"] = "Add Grade";
}

<div class="container py-4 py-lg-5 faculty-dashboard">

    <header class="faculty-page-heading">
        <div>
            <span class="faculty-eyebrow faculty-eyebrow-dark">
                <i class="bi bi-journal-plus"></i>
                GRADE MANAGEMENT
            </span>
            <h1>Add Grade Record</h1>
            <p>Enter the student's information and academic result.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Records
        </a>
    </header>

    <section class="faculty-form-panel">
        <div class="faculty-form-intro">
            <div class="faculty-form-intro-icon">
                <i class="bi bi-file-earmark-plus"></i>
            </div>
            <div>
                <h2>New Academic Record</h2>
                <p>Fields marked as required must be completed before saving.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger faculty-validation-summary"></div>

            <div class="faculty-form-section">
                <div class="faculty-form-section-heading">
                    <span class="faculty-form-section-icon">
                        <i class="bi bi-person-badge"></i>
                    </span>
                    <div>
                        <h3>Student Information</h3>
                        <p>Select the student receiving this grade.</p>
                    </div>
                </div>

                <div class="field-group">
                    <label asp-for="StudentId" class="form-label">
                        Select Student <span class="required-mark">*</span>
                    </label>

                    <select asp-for="StudentId" class="form-select">
                        <option value="0">Choose a student...</option>
                        @foreach (var student in Model.Students)
                        {
                            <option value="@student.StudentId">
                                @student.StudentNumber - @student.StudentName
                            </option>
                        }
                    </select>

                    <span class="form-hint">Choose the student whose academic result you are recording.</span>
                    <span asp-validation-for="StudentId" class="text-danger small"></span>
                </div>
            </div>

            <div class="faculty-form-section">
                <div class="faculty-form-section-heading">
                    <span class="faculty-form-section-icon">
                        <i class="bi bi-book"></i>
                    </span>
                    <div>
                        <h3>Subject and Grade Details</h3>
                        <p>Provide the subject information and final grade.</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 field-group">
                        <label asp-for="SubjectCode" class="form-label">
                            Subject Code <span class="required-mark">*</span>
                        </label>
                        <input asp-for="SubjectCode"
                               class="form-control"
                               placeholder="Example: IT101" />
                        <span asp-validation-for="SubjectCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 field-group">
                        <label asp-for="SubjectName" class="form-label">
                            Subject Name <span class="required-mark">*</span>
                        </label>
                        <input asp-for="SubjectName"
                               class="form-control"
                               placeholder="Example: Introduction to Computing" />
                        <span asp-validation-for="SubjectName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="field-group">
                    <label asp-for="Grade" class="form-label">
                        Grade <span class="required-mark">*</span>
                    </label>
                    <input asp-for="Grade"
                           type="number"
                           min="0"
                           max="100"
                           step="1"
                           class="form-control faculty-grade-input"
                           placeholder="Enter a grade from 0 to 100" />
                    <span class="form-hint">Enter a whole-number grade between 0 and 100.</span>
                    <span asp-validation-for="Grade" class="text-danger small"></span>
                </div>
            </div>

            <div class="faculty-form-section">
                <div class="faculty-form-section-heading">
                    <span class="faculty-form-section-icon">
                        <i class="bi bi-calendar3"></i>
                    </span>
                    <div>
                        <h3>Academic Period</h3>
                        <p>Specify when the subject was taken.</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 field-group">
                        <label asp-for="Semester" class="form-label">
                            Semester <span class="required-mark">*</span>
                        </label>
                        <select asp-for="Semester" class="form-select">
                            <option value="">Choose semester...</option>
                            <option>1st Semester</option>
                            <option>2nd Semester</option>
                            <option>Summer</option>
                        </select>
                        <span asp-validation-for="Semester" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 field-group">
                        <label asp-for="SchoolYear" class="form-label">
                            School Year <span class="required-mark">*</span>
                        </label>
                        <input asp-for="SchoolYear"
                               class="form-control"
                               placeholder="2026-2027" />
                        <span class="form-hint">Format: YYYY-YYYY</span>
                        <span asp-validation-for="SchoolYear" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="faculty-form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Save Grade Record
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}