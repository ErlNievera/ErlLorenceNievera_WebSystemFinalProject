
@model StudentGradeManagement.Mvc.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In - Student Grade Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-container">
        <section class="login-card">
            <div class="login-brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div class="page-eyebrow">
                <i class="bi bi-shield-check"></i>
                Academic Portal
            </div>

            <h1>Welcome back</h1>
            <p class="text-muted mb-4">
                Sign in to access your academic account.
            </p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="field-group">
                    <label asp-for="Email" class="form-label">
                        Email address
                    </label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="you@example.com"
                           autocomplete="username"
                           autofocus />
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="field-group mb-4">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password" />
                    <span asp-validation-for="Password"
                          class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign In
                </button>
            </form>

            <p class="text-muted text-center small mt-4 mb-0">
                <i class="bi bi-lock-fill me-1"></i>
                Your account information is protected.
            </p>
        </section>

        <p class="text-muted text-center small mt-3">
            Student Grade Management System
        </p>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
